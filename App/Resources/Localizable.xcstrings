    "Browser extension" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة المتصفح"
          }
        }
      }
    },
    "Capture or detection needs attention. Open Sitr for status and recovery actions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقاط الشاشة أو الاكتشاف يحتاج إلى إجراء. افتح سِتر لعرض الحالة وخيارات الاستعادة."
          }
        }
      }
    },
    "Captures at 8 frames per second instead of 15 while the Mac is in Low Power Mode." : {
      "comment" : "General › Low Power footer",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلتقط الشاشة بمعدل ٨ إطارات في الثانية بدلًا من ١٥ عندما يكون جهاز Mac في نمط الطاقة المنخفضة."
          }
        }
      }
    },
    "Changes apply to the covers on screen immediately." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق التغييرات على الأغطية الظاهرة على الشاشة فورًا."
          }
        }
      }
    },
    "Changes apply until quit; saving failed. Retry to keep these settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسري التغييرات حتى إغلاق التطبيق، لكن تعذّر حفظها. أعد المحاولة للاحتفاظ بهذه الإعدادات."
          }
        }
      }
    },
    "Check for Updates" : {
      "comment" : "Accessibility label",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
