{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ has no bundle identifier, so no rule can be stored for it." : {
      "comment" : "Error under the overrides table; %@ is the chosen file name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحمل %@ معرّف حزمة، لذا لا يمكن حفظ قاعدة له."
          }
        }
      }
    },
    "%@ is %@, a system shortcut." : {
      "comment" : "Shortcut recorder rejection; %1$@ the combo such as ⌘Q, %2$@ its system use such as Quit",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ اختصار للنظام (%2$@)."
          }
        }
      }
    },
    "%@ is also used by %@." : {
      "comment" : "Shortcut conflict warning; %1$@ the combo, %2$@ the other software",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ يستخدمه أيضًا %2$@."
          }
        }
      }
    },
    "%lld more saved for apps that are not installed. They apply once installed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "و%lld محفوظة لتطبيقات غير مثبّتة، وتُطبَّق عند تثبيتها."
          }
        }
      }
    },
    "1 hour" : {
      "comment" : "Menu bar › Pause Protection submenu",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعة واحدة"
          }
        }
      }
    },
    "15 minutes" : {
      "comment" : "Menu bar › Pause Protection submenu",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "١٥ دقيقة"
          }
        }
      }
    },
    "About" : {
      "comment" : "Settings tab",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حول"
