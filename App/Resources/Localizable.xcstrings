        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ"
          }
        }
      }
    },
    "Copy the verification command" : {
      "comment" : "Accessibility label, About › Copy",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ أمر التحقق"
          }
        }
      }
    },
    "Could not download the voice model. Check your internet connection; Sitr keeps trying." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تنزيل نموذج الصوت. تحقّق من اتصالك بالإنترنت، وسيواصل Sitr المحاولة."
          }
        }
      }
    },
    "Could not start" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر التشغيل"
          }
        }
      }
    },
    "Could not stop helper" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إيقاف مساعد الصوت"
          }
        }
      }
    },
    "Cover style" : {
      "comment" : "Accessibility label of the Appearance style picker",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمط الغطاء"
          }
        }
      }
    },
    "Covers" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأغطية"
          }
        }
      }
    },
    "Covers women, men, or everyone in your browsers and chat apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغطّي النساء أو الرجال أو الجميع في متصفحاتك وتطبيقات المحادثة."
          }
        }
      }
    },
    "Curtain" : {
      "comment" : "Per-app rule mode: cover changes at once, uncover what is verified safe",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الستارة"
          }
        }
      }
    },
    "Curtain: covers new content instantly, then uncovers what is safe. Best for browsers and chats. Blur: covers people as soon as they are detected. Off: Sitr never looks at the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الستارة: تغطي المحتوى الجديد فورًا ثم تكشف ما ثبت أنه آمن، وهي الأنسب للمتصفحات والمحادثات. التمويه: يغطي الأشخاص فور اكتشافهم. إيقاف: لا ينظر Sitr إلى التطبيق أبدًا."
          }
        }
      }
    },
    "Degraded" : {
      "comment" : "Menu bar status line: detection is slow, covers may lag",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أداء الحماية منخفض"
          }
        }
      }
    },
    "Detection has repeatedly failed. Existing covers remain; new people may be missed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل الاكتشاف عدة مرات. تبقى الحواجز الحالية، لكن قد لا يُكتشَف أشخاص جدد."
          }
        }
      }
    },
    "Detection is slower than 250 ms per frame, so covers can lag until it speeds up again." : {
      "comment" : "Settings › General footer, shown only in the degraded state",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاكتشاف أبطأ من ٢٥٠ ملّي ثانية لكل إطار، لذا قد تتأخر الأغطية إلى أن تتحسّن السرعة."
          }
        }
      }
    },
    "Detection needs attention" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتشاف الأشخاص يحتاج إلى إجراء"
          }
        }
      }
    },
    "Disabled" : {
      "comment" : "Menu bar status line: protection disabled by the user",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحماية معطّلة"
          }
        }
      }
    },
    "Done" : {
      "comment" : "Onboarding primary button on the permission-only reopen",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم"
          }
        }
      }
    },
    "Download Google Chrome" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنزيل Google Chrome"
          }
        }
      }
    },
    "Downloading the voice model…" : {
