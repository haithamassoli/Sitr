        }
      }
    },
    "All apps except overrides" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل التطبيقات باستثناء التطبيقات المستثناة"
          }
        }
      }
    },
    "All other apps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "باقي التطبيقات"
          }
        }
      }
    },
    "Allow Screen Recording" : {
      "comment" : "Onboarding step 2 title and button",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بتسجيل الشاشة"
          }
        }
      }
    },
    "Allow Screen Recording first, or choose Skip for now" : {
      "comment" : "Accessibility hint on the disabled Continue button, onboarding step 2",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بتسجيل الشاشة أولًا، أو اختر «التخطي الآن»"
          }
        }
      }
    },
    "Allow Screen Recording to resume detection. Curtain apps stay covered; Blur apps are uncovered." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بتسجيل الشاشة لاستئناف الاكتشاف. تبقى تطبيقات وضع الستارة محجوبة، أما تطبيقات وضع التمويه فلا تبقى محجوبة."
          }
        }
      }
    },
    "Also covers people whose category is unknown" : {
      "comment" : "Accessibility hint, Strict Mode toggle",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغطي أيضًا الأشخاص الذين فئتهم غير معروفة"
          }
        }
      }
    },
    "Also hides people Sitr cannot tell apart: facing away, face hidden or too small." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي أيضًا من لا يستطيع Sitr تمييزهم: من يدير ظهره، أو وجهه مخفي أو صغير جدًا."
          }
        }
      }
    },
    "Always on while Everyone is selected" : {
      "comment" : "Accessibility hint, Strict Mode toggle",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفعّل دائمًا عند اختيار «الجميع»"
          }
        }
      }
    },
    "Applies at once, no relaunch" : {
      "comment" : "Accessibility hint, Reset to Default",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطبَّق فورًا دون إعادة تشغيل"
          }
        }
      }
    },
    "Applying protection rules" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ تطبيق قواعد الحماية"
          }
        }
      }
    },
    "Approve Sitr in System Settings › Login Items." : {
      "comment" : "General › Launch at login, when macOS requires approval",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وافق على Sitr في إعدادات النظام › عناصر تسجيل الدخول."
          }
        }
      }
    },
    "Audio is processed on this Mac. The first time, Sitr downloads a voice model (about 80 MB); after that the helper only downloads the audio of videos you choose." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعالَج الصوت على هذا الـMac. في المرة الأولى ينزّل Sitr نموذج الصوت (نحو 80 ميغابايت)، وبعدها لا ينزّل المساعد إلا صوت الفيديوهات التي تختارها."
          }
        }
      }
    },
    "Back" : {
      "comment" : "Onboarding button",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رجوع"
