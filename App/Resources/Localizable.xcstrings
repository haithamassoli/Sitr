    },
    "Add apps under Where to hide to start hiding people." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف تطبيقات ضمن «أين يُطبَّق الإخفاء» لبدء إخفاء الأشخاص."
          }
        }
      }
    },
    "Add at least one modifier key (⌃, ⌥, ⇧ or ⌘)." : {
      "comment" : "Shortcut recorder rejection",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مفتاح تعديل واحدًا على الأقل (⌃ أو ⌥ أو ⇧ أو ⌘)."
          }
        }
      }
    },
    "Add browsers and chat apps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة المتصفحات وتطبيقات المحادثة"
          }
        }
      }
    },
    "Add the browser extension" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف إضافة المتصفح"
          }
        }
