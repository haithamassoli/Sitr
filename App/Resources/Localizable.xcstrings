            "state" : "translated",
            "value" : "متابعة"
          }
        }
      }
    },
    "Continues without Screen Recording. Person detection stays off; Curtain app windows remain covered." : {
      "comment" : "Accessibility hint, Skip for now",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتابع دون إذن تسجيل الشاشة. يتوقف كشف الأشخاص، وتبقى نوافذ تطبيقات الستارة مغطاة."
          }
        }
      }
    },
    "Copied" : {
      "comment" : "About › Copy button after a click",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم النسخ"
          }
        }
      }
    },
    "Copied. In the browser, press ⌘L, then ⌘V, then Return." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم النسخ. في المتصفح اضغط ⌘L ثم ⌘V ثم Return."
          }
        }
      }
    },
    "Copy" : {
      "comment" : "About › Copy button",
