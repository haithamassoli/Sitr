    "Curtain" : {
      "comment" : "Per-app rule mode: cover changes at once, uncover what is verified safe",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الستارة"
